# Inputs for the contract test: `npm run test:e2e`
#
# Copy to .env.local (gitignored) and fill in, or export them in your shell.
# scripts/e2e.mjs reads .env.local automatically; real environment variables
# always win, so CI is unaffected.
# The same names are the repository secrets the E2E workflow reads.

# ---------------------------------------------------------------------------
# Required. Without these the test refuses to run.
# ---------------------------------------------------------------------------

# Public API key, format keyId.keySecret. Split on '.' and sent Base64'd as
# `Authorization: Basic`. Use a PUBLIC key: it carries exactly the ingestion
# scopes the SDK needs. Never a private or admin key in an app server.
INTEMPT_API_KEY=

# URL slug, not a numeric id. Goes in /v1/{org}/...
INTEMPT_ORGANIZATION_ID=

# URL slug. Goes in /projects/{project}/
INTEMPT_PROJECT_ID=

# Ingestion source. Goes in /sources/{source}/track. A real id is 19 digits and
# is always handled as a string — never a JS number, which would round it.
INTEMPT_SOURCE_ID=

# API host. Defaults to api.intempt.com.
INTEMPT_HOST=api.intempt.com

# ---------------------------------------------------------------------------
# Project-resident entities. Each must ALREADY EXIST in the project above.
# Any step needing a missing one is reported as SKIP, never as a pass:
# ingestion returns 201 for unknown ids, so a fabricated value would look
# green and prove nothing.
# ---------------------------------------------------------------------------

# A stable existing profile. Keeps runs idempotent and lets results be eyeballed
# in the console. Without it the test mints sdk-e2e-<epoch> and leaves a
# throwaway profile behind on every run.
INTEMPT_E2E_USER_ID=

# Optional. group() provisions the account if it does not exist, so this only
# needs setting to point the test at a specific existing account.
INTEMPT_E2E_ACCOUNT_ID=

# An existing product feed id, for decide.recommend() -> /feeds/{id}/data
INTEMPT_E2E_FEED_ID=

# A productId that exists in the catalog, for the ecommerce.* calls.
INTEMPT_E2E_PRODUCT_ID=

# Field names for recommend(). These are product attribute names from the
# project's catalog schema (product_attribute_outbox), not arbitrary strings.
# Comma-separated; defaults to "id" if unset.
INTEMPT_E2E_FEED_FIELDS=id
