{
  "name": "intempt",
  "version": "2.0.0",
  "description": "Server-side Node.js client for the Intempt platform: data in, decisions out.",
  "keywords": [
    "intempt",
    "cdp",
    "analytics",
    "personalization",
    "recommendations"
  ],
  "homepage": "https://github.com/intempt/intempt-node#readme",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intempt/intempt-node.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:consumer": "bash scripts/verify-consumer.sh",
    "test:e2e": "node scripts/e2e.mjs",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "https-proxy-agent": "7.0.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^3.2.7",
    "nock": "^14.0.10",
    "oxlint": "^1.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
