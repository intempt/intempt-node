{
  "name": "intempt",
  "version": "2.0.0",
  "description": "Server-side Node.js client for the Intempt platform: data in, decisions out.",
  "keywords": [
    "intempt",
    "cdp",
    "analytics",
    "personalization",
    "recommendations"
  ],
  "homepage": "https://github.com/intempt/intempt-node#readme",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intempt/intempt-node.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "https-proxy-agent": "7.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "nock": "^14.0.10",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
