# Quarantine freshly published versions so a compromised release cannot enter an
# install before anyone notices.
#
# Honest caveat: this is honoured by pnpm (as minimumReleaseAge) and by recent
# npm. npm 10, which ships with Node 20 and 22, stores it as an unknown user
# config and ignores it — verified against npm 10.9.2, where `npm help config`
# has no entry for it. So it is a belt-and-braces setting, not a guarantee on
# every CI leg. Dependabot plus a committed lockfile are what actually gate
# dependency changes here.
min-release-age=7

# Stop `npx` from silently downloading packages that are not in node_modules.
# Equivalent to passing `--no` to every npx invocation.
yes=false
